{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf lib/",
    "start": "npm run build && firebase emulators:start --import=./imports",
    "start:shell": "npm run build && firebase functions:shell",
    "start:debug": "npm run build && firebase emulators:start --inspect-functions --import=./imports",
    "dev": "concurrently \"npm run build:watch\" \"npm run emulators\"",
    "emulators": "firebase emulators:start --import=./imports",
    "emulators:export": "firebase emulators:export ./imports",
    "seed": "node scripts/seed-data.js",
    "import:sample": "node scripts/import-data.js production-sample.json",
    "import": "node scripts/import-data.js",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:emulators": "firebase emulators:exec --only firestore,auth \"npm test\""
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.9",
    "dayjs": "^1.11.14",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "private": true
}