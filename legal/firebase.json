{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ],
    "redirects": [{ "source": "/", "destination": "/privacy.html", "type": 302 }]
  }
}
