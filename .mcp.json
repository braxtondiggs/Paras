{
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "experimental:mcp"],
      "env": {
        "FIREBASE_PROJECT": "paras-293d5"
      }
    },
    "forgejo": {
      "command": "npx",
      "args": ["-y", "gitea-mcp@latest"],
      "env": {
        "GITEA_HOST": "https://git.braxt.in",
        "GITEA_ACCESS_TOKEN": "${FORGEJO_TOKEN_MCP}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "env": {}
    },
    "nx": {
      "command": "npx",
      "args": ["-y", "@nx/mcp"],
      "env": {}
    }
  }
}
