{
  "name": "paras",
  "version": "2.0.3",
  "author": "Braxton Diggs",
  "homepage": "https://braxtondiggs.com/",
  "scripts": {
    "start": "ng serve",
    "start:android": "ionic capacitor run android --livereload --external --host=0.0.0.0",
    "build": "rm -rf ./www && ionic capacitor sync",
    "stats": "ng build --stats-json && webpack-bundle-analyzer ./www/stats.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch --runInBand",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "20"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.1.8",
    "@angular/common": "20.1.8",
    "@angular/compiler": "20.1.8",
    "@angular/core": "20.1.8",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "20.1.8",
    "@angular/platform-browser": "20.1.8",
    "@angular/platform-browser-dynamic": "20.1.8",
    "@angular/router": "20.1.8",
    "@awesome-cordova-plugins/core": "^8.1.0",
    "@awesome-cordova-plugins/launch-review": "^8.1.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/network": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.2",
    "@ionic/angular": "^8.7.3",
    "capacitor-email-composer": "^7.0.2",
    "cordova-launch-review": "^4.0.1",
    "cordova-plugin-purchase": "^13.10.0",
    "dayjs": "^1.10.7",
    "firebase": "^12.2.1",
    "rxjs": "^7.8.1",
    "swiper": "^11.0.5",
    "tslib": "^2.0.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.1.6",
    "@angular-devkit/core": "20.1.6",
    "@angular-devkit/schematics": "20.1.6",
    "@angular-eslint/eslint-plugin": "^20.2.0",
    "@angular-eslint/eslint-plugin-template": "^20.2.0",
    "@angular-eslint/template-parser": "^20.2.0",
    "@angular/cli": "~20.1.0",
    "@angular/compiler-cli": "20.1.8",
    "@capacitor/cli": "^7.4.3",
    "@ngneat/spectator": "^21.0.1",
    "@schematics/angular": "20.1.6",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.0.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "14.6.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.0",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "type": "module",
  "description": "Get updates on alternate street parking rules & schedules with NYC parking app."
}
